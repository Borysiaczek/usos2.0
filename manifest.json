{
  "manifest_version": 3,
  "name": "USOSweb 2.0 - Nowoczesny USOSweb",
  "version": "1.0.0",
  "description": "Nowoczesny, minimalistyczny interfejs dla USOSweb (Politechnika Śląska i polskie uczelnie) w estetyce Tailwind UI i shadcn/ui.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "USOSweb 2.0 - Konfiguracja",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.polsl.pl/*",
        "*://*.edu.pl/*",
        "*://*.umcs.pl/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
